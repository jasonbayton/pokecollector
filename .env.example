# Initial bootstrap settings for the backend container
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible API (Ollama, llama.cpp, LM Studio) to scan with a
# local model. Leave unset for the hosted OpenAI API. A local endpoint usually
# needs no key, so OPENAI_API_KEY can stay empty when this is set.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# Which vision model reads card photos: gemini (default) or openai.
# The admin-set scanner_provider setting takes precedence over this.
SCANNER_PROVIDER=gemini
# Off by default: when true, accounts without their own key fall back to the
# key above, so one installation key covers every user. Consider the billing
# and isolation implications on a multi-user install before enabling.
ALLOW_SHARED_SCANNER_KEY=false
# Default currency for new accounts: EUR (default), USD or GBP.
DEFAULT_CURRENCY=EUR
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TCGDEX_SYNC_LANGUAGES=en,de
PUBLIC_MODE=false
CORS_ORIGINS=

# Automatic safety backup before startup migrations on version changes
PRE_UPGRADE_BACKUP_ENABLED=true
PRE_UPGRADE_BACKUP_REQUIRED=true
PRE_UPGRADE_BACKUP_KEEP=10
