# Initial bootstrap settings for the backend container
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
# OpenAI-compatible scanner provider, covering hosted OpenAI and any compatible
# local server such as Ollama, llama.cpp or LM Studio.
#
# The endpoint is deliberately an administrator setting and not a per-user one:
# a user-supplied backend URL would let any account point the server at an
# arbitrary host. From inside the backend container 127.0.0.1 is that container,
# so a model running on the host is reached via host.docker.internal.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=gpt-5.6-luna

# Which vision model reads card photos: gemini (default) or openai. Each user
# can choose their own in Settings; this is what accounts that have not chosen
# will use.
SCANNER_PROVIDER=gemini

# Keys are per user. GEMINI_API_KEY and OPENAI_API_KEY above are the
# installation fallback for any account that has not set its own, so setting one
# provides a key for everyone and leaving it empty requires each user to supply
# their own. A local endpoint usually needs no key at all.

# Default currency for new accounts: EUR (default), USD or GBP.
DEFAULT_CURRENCY=EUR

# Optional server-side scanner diagnostics. Users still opt in individually.
# Keep SCAN_TRACE_STORAGE_DIR stable so users can delete previously stored data
# even while collection is disabled. Docker Compose sets this automatically.
# SCAN_TRACE_STORAGE_DIR=/app/data/scan-traces
# SCAN_TRACE_DIR=/app/data/scan-traces
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TCGDEX_SYNC_LANGUAGES=en,de
PUBLIC_MODE=false
CORS_ORIGINS=

# Automatic safety backup before startup migrations on version changes
PRE_UPGRADE_BACKUP_ENABLED=true
PRE_UPGRADE_BACKUP_REQUIRED=true
PRE_UPGRADE_BACKUP_KEEP=10
