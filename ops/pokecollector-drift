#!/usr/bin/env bash
#
# Has the serving checkout drifted from the tag the deploy recorded?
#
# Deliberately NOT a liveness check. pokecollector-health.timer already polls
# the health endpoint, restarts after two consecutive failures and alerts
# through the same helper; a second checker would race its restarts and send a
# second email for one incident.
#
# Drift is what nothing else notices: a hand fix applied on the box, which the
# next release silently overwrites, or a checkout left somewhere unexpected by
# an interrupted deploy.
#
set -uo pipefail

REPO=${POKECOLLECTOR_REPO:-/opt/pokecollector}
STATE=${POKECOLLECTOR_STATE:-/var/lib/pokecollector-deploy}

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

[ -f "${STATE}/deployed" ] || { log "no release recorded yet, nothing to compare"; exit 0; }

expected_tag=$(cat "${STATE}/deployed")
expected_sha=$(git -C "${REPO}" rev-list -n 1 "${expected_tag}" 2>/dev/null || echo "")
actual_sha=$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo "")

if [ -z "${expected_sha}" ]; then
  log "recorded tag ${expected_tag} no longer resolves, skipping"
  exit 0
fi

if [ "${expected_sha}" = "${actual_sha}" ]; then
  exit 0
fi

log "ALERT: checkout drifted from ${expected_tag}"
if command -v pokecollector-alert >/dev/null 2>&1; then
  printf 'The serving checkout is not the release that was deployed.\n\nRecorded: %s (%s)\nHEAD:     %s\nHost:     %s\n\nSomething changed the checkout outside the deploy path. The next release will overwrite it.\n' \
    "${expected_tag}" "${expected_sha}" "${actual_sha}" "$(hostname)" \
    | pokecollector-alert "PokeCollector checkout has drifted from its deployed tag" >/dev/null 2>&1 || true
fi
exit 1
