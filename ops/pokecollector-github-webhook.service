[Unit]
Description=PokeCollector signed GitHub release webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/pokecollector-webhook.env
ExecStart=/usr/local/bin/pokecollector-github-webhook
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
