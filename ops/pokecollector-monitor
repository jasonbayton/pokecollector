#!/usr/bin/env bash
#
# Liveness and drift. Separate from the deploy path on purpose: the deploy
# script only runs when there is a new tag, so it cannot notice a service that
# died an hour later, or a checkout someone changed by hand.
#
set -uo pipefail

REPO=${POKECOLLECTOR_REPO:-/opt/pokecollector}
STATE=${POKECOLLECTOR_STATE:-/var/lib/pokecollector-deploy}
SERVICE=${POKECOLLECTOR_SERVICE:-pokecollector}
HEALTH_URL=${POKECOLLECTOR_HEALTH_URL:-http://127.0.0.1:8000/api/health}

alert() {
  local subject=$1 body=$2
  printf '%s ALERT: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${subject}"
  if command -v outpost >/dev/null 2>&1; then
    outpost mail send -f llm@api.bayton.org --from-name "PokeCollector monitor" \
      -t jason@bayton.org -s "${subject}" --text "${body}" >/dev/null 2>&1 || true
  fi
}

if ! systemctl is-active --quiet "${SERVICE}"; then
  alert "PokeCollector service is not running" \
    "systemctl reports ${SERVICE} is not active on $(hostname)."
  exit 1
fi

if ! curl -fsS -o /dev/null --max-time 10 "${HEALTH_URL}"; then
  alert "PokeCollector is not answering its health check" \
    "${SERVICE} is active but ${HEALTH_URL} did not answer on $(hostname). Active is not the same as healthy."
  exit 1
fi

# Drift: what is checked out should be the tag the deploy recorded. A manual
# fix on the box is exactly the thing that gets forgotten and then overwritten.
if [ -f "${STATE}/deployed" ]; then
  expected_tag=$(cat "${STATE}/deployed")
  expected_sha=$(git -C "${REPO}" rev-list -n 1 "${expected_tag}" 2>/dev/null || echo "")
  actual_sha=$(git -C "${REPO}" rev-parse HEAD 2>/dev/null || echo "")
  if [ -n "${expected_sha}" ] && [ "${expected_sha}" != "${actual_sha}" ]; then
    alert "PokeCollector checkout has drifted from its deployed tag" \
      "Recorded ${expected_tag} (${expected_sha}) but HEAD is ${actual_sha} on $(hostname). Something changed the checkout outside the deploy path."
    exit 1
  fi
fi
